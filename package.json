{
  "name": "rewind-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/web"],
  "packageManager": "npm@10.9.3",
  "engines": { "node": ">=22.12.0 <23", "npm": ">=10 <11" },
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "test:e2e": "node scripts/browser.cjs test",
    "browsers:install": "node scripts/browser.cjs install"
  },
  "devDependencies": { "@playwright/test": "1.64.0" }
}
