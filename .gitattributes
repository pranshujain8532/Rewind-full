* text=auto
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf

# Preserve reviewed font/notice bytes, including upstream notice whitespace.
apps/web/public/fonts/*.ttf -text
apps/web/public/licenses/*.txt -text -whitespace

# Raw public demonstration key must survive publication byte-for-byte.
docs/project/evidence/p7-example/*.ed25519 -text
docs/project/evidence/p8-example/*.ed25519 -text
